name: Automated Deployment v3

on:
  workflow_dispatch:
    inputs:
      source_branch:
        description: 'Source branch to deploy from'
        required: true
        type: string
      destination_branch:
        description: 'Destination branch to deploy to'
        required: true
        type: string
      file_names:
        description: 'Comma-separated list of files (extension optional)'
        required: false
        type: string
      exclude_files:
        description: 'Files to exclude (comma-separated)'
        required: false
        type: string
        default: 'source.yml,relx_fivetran_connector_mapping.csv'

permissions:
  contents: write
  pull-requests: write
  issues: write

jobs:
  create-deployment-pr:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          # Use the workflow's token (more secure than passing a PAT via input)
          token: ${{ secrets.GITHUB_TOKEN }}
          fetch-depth: 0

      - name: Configure Git
        run: |
          git config user.name "GitHub Actions Bot"
          git config user.email "actions@github.com"

      - name: Validate branches exist
        shell: bash
        run: |
          set -euo pipefail
          src="${{ inputs.source_branch }}"
          dst="${{ inputs.destination_branch }}"
          git ls-remote --heads origin "$src" | grep -q "refs/heads/${src}$" || { echo "Source branch '$src' not found"; exit 1; }
          git ls-remote --heads origin "$dst" | grep -q "refs/heads/${dst}$" || { echo "Destination branch '$dst' not found"; exit 1; }

      - name: Create merger branch
        id: create_branch
        shell: bash
        run: |
          set -euo pipefail
          TS="$(date +%Y%m%d_%H%M%S)"
          SRC="$(echo "${{ inputs.source_branch }}" | tr '[:upper:]' '[:lower:]' | sed 's/[\/ ]/_/g')"
          DST="$(echo "${{ inputs.destination_branch }}" | tr '[:upper:]' '[:lower:]' | sed 's/[\/ ]/_/g')"
          MERGER_BRANCH="${SRC}_to_${DST}_merger_${TS}"
          echo "merger_branch=${MERGER_BRANCH}" >> "$GITHUB_OUTPUT"

          git fetch origin "${{ inputs.destination_branch }}"
          git checkout -b "${MERGER_BRANCH}" "origin/${{ inputs.destination_branch }}"
          git push -u origin "${MERGER_BRANCH}"

      - name: Get changed files
        shell: bash
        run: |
          set -euo pipefail
          git fetch origin "${{ inputs.source_branch }}"
          # Diff from destination to source to list all changes present in source
          git diff --name-only --diff-filter=ACMR \
            "origin/${{ inputs.destination_branch }}...origin/${{ inputs.source_branch }}" \
            > /tmp/all_changed_files.txt || true

      - name: Cherry-pick / Checkout files
        id: cherry_pick
        shell: bash
        run: |
          set -euo pipefail
          git checkout "${{ steps.create_branch.outputs.merger_branch }}"

          FILE_NAMES_INPUT="${{ inputs.file_names }}"
          EXCLUDE_FILES="${{ inputs.exclude_files }}"
          CHANGED_FILES="$(cat /tmp/all_changed_files.txt || true)"

          # Build exclude array
          IFS=',' read -r -a EXCLUDE_ARRAY <<< "$EXCLUDE_FILES"

          FILES_TO_DEPLOY=""
          DEPLOYED_FILES=""
          FAILED_FILES=""
          DEPLOYED_COUNT=0

          trim() { sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }

          if [ -z "${FILE_NAMES_INPUT// }" ]; then
            FILES_TO_DEPLOY="$CHANGED_FILES"
          else
            IFS=',' read -r -a INPUT_FILES <<< "$FILE_NAMES_INPUT"
            for input in "${INPUT_FILES[@]}"; do
              input="$(echo "$input" | trim)"
              [ -z "$input" ] && continue
              if echo "$input" | grep -q '\.'; then
                # exact filename match in change list
                MATCH="$(echo "$CHANGED_FILES" | grep -Fx "$input" || true)"
              else
                # name without extension (match any extension)
                MATCH="$(echo "$CHANGED_FILES" | grep -E "(^|/)${input}\.[A-Za-z0-9._-]+$" || true)"
              fi
              if [ -n "$MATCH" ]; then
                FILES_TO_DEPLOY="${FILES_TO_DEPLOY}${MATCH}"$'\n'
              else
                FAILED_FILES="${FAILED_FILES}- ${input} (no match found)"$'\n'
              fi
            done
          fi

          # Unique list
          echo "$FILES_TO_DEPLOY" | sort -u > /tmp/files_to_deploy.txt
          git fetch origin "${{ inputs.source_branch }}"

          while IFS= read -r file; do
            [ -z "$file" ] && continue
            # Apply excludes
            SKIP=false
            for ex in "${EXCLUDE_ARRAY[@]}"; do
              ex="$(echo "$ex" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
              [ -z "$ex" ] && continue
              if echo "$file" | grep -Fq "$ex"; then
                SKIP=true
                break
              fi
            done
            $SKIP && continue

            # Checkout file content from source branch into current working tree
            git checkout "origin/${{ inputs.source_branch }}" -- "$file"
            git add "$file"
            DEPLOYED_FILES="${DEPLOYED_FILES}- ${file}"$'\n'
            DEPLOYED_COUNT=$((DEPLOYED_COUNT + 1))
          done < /tmp/files_to_deploy.txt

          echo "$DEPLOYED_FILES" > /tmp/deployed_files.txt
          echo "$FAILED_FILES" > /tmp/failed_files.txt
          echo "$DEPLOYED_COUNT" > /tmp/deployed_count.txt

          if [ -n "$(git status --porcelain)" ]; then
            echo "has_changes=true" >> "$GITHUB_OUTPUT"
          else
            echo "has_changes=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Commit changes
        if: steps.cherry_pick.outputs.has_changes == 'true'
        shell: bash
        run: |
          set -euo pipefail
          git commit -m "Automated deployment"
          git push origin "${{ steps.create_branch.outputs.merger_branch }}"

      - name: Create Pull Request
        if: steps.cherry_pick.outputs.has_changes == 'true'
        uses: actions/github-script@v7
        id: create_pr
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            const fs = require('fs');
            const deployedFiles = fs.existsSync('/tmp/deployed_files.txt') ? fs.readFileSync('/tmp/deployed_files.txt','utf8') : '';
            const failedFiles = fs.existsSync('/tmp/failed_files.txt') ? fs.readFileSync('/tmp/failed_files.txt','utf8') : '';
            const allChanges = fs.existsSync('/tmp/all_changed_files.txt') ? fs.readFileSync('/tmp/all_changed_files.txt','utf8') : '';
            const deployedCount = fs.existsSync('/tmp/deployed_count.txt') ? fs.readFileSync('/tmp/deployed_count.txt','utf8').trim() : '0';
            const filesList = allChanges.split('\n').filter(f => f.trim());

            const src = `${{ inputs.source_branch }}`;
            const dst = `${{ inputs.destination_branch }}`;
            const headBranch = `${{ steps.create_branch.outputs.merger_branch }}`;
            const actor = context.actor;
            const fileNames = `${{ inputs.file_names }}`;

            let bodyText = '## 🚀 Deployment Request\\n\\n';
            bodyText += `**Source Branch:** \`${src}\`\\n`;
            bodyText += `**Destination Branch:** \`${dst}\`\\n`;
            bodyText += `**Triggered by:** @${actor}\\n\\n`;
            bodyText += '### 📋 Deployment Summary\\n\\n';

            if (!fileNames) {
              bodyText += `**Mode:** Full deployment (all changes)\\n`;
              bodyText += `**Total changes in source:** ${filesList.length} files\\n`;
              bodyText += `**Successfully deployed:** ${deployedCount} files\\n\\n`;
            } else {
              bodyText += `**Mode:** Selective deployment\\n`;
              bodyText += `**Successfully deployed:** ${deployedCount} files\\n\\n`;
            }

            bodyText += '### ✅ Successfully Deployed Files\\n';
            bodyText += '```\\n' + (deployedFiles || 'None') + '\\n```\\n\\n';

            if (failedFiles.trim()) {
              bodyText += '### ⚠️ Failed Files\\n';
              bodyText += '```\\n' + failedFiles + '\\n```\\n\\n';
            }

            bodyText += '### 🔒 Excluded Files (Auto-restored from destination if present)\\n';
            bodyText += '- source.yml\\n- relx_fivetran_connector_mapping.csv\\n\\n';

            bodyText += '### 📝 Next Steps\\n';
            bodyText += '1. Review the changes in this PR\\n';
            bodyText += '2. Approve the PR if everything looks correct\\n';
            bodyText += `3. Merge to deploy to \`${dst}\`\\n`;
            bodyText += '4. **Manual Step**: Run your dbt jobs after merge\\n\\n';

            if (!fileNames) {
              bodyText += `### 📊 All Changed Files in Source\\n<details><summary>Click to expand (${filesList.length} files)</summary>\\n\\n`;
              filesList.forEach(file => { bodyText += `- ${file}\\n`; });
              bodyText += `\\n</details>`;
            }

            const pr = await github.rest.pulls.create({
              owner: context.repo.owner,
              repo: context.repo.repo,
              title: `Deployment Request: ${src} → ${dst}`,
              head: headBranch,
              base: dst,
              body: bodyText
            });

            return pr.data.number;

      - name: Add labels to PR
        if: steps.cherry_pick.outputs.has_changes == 'true'
        uses: actions/github-script@v7
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          script: |
            const prNumber = Number(`${{ steps.create_pr.outputs.result }}` || 0);
            if (!prNumber) {
              console.log('No PR number available; skipping label addition.');
              return;
            }
            try {
              await github.rest.issues.addLabels({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: prNumber,
                labels: ['automated-deployment', 'deployment']
              });
              console.log('Labels added to PR:', prNumber);
            } catch (error) {
              console.log('Could not add labels (they may not exist):', error.message);
            }

      - name: Summary
        if: steps.cherry_pick.outputs.has_changes == 'true'
        shell: bash
        run: |
          {
            echo "## ✅ Deployment PR Created Successfully"
            echo ""
            echo "**PR Number:** ${{ steps.create_pr.outputs.result }}"
            echo "**Merger Branch:** \`${{ steps.create_branch.outputs.merger_branch }}\`"
            echo ""
            echo "### Next Steps:"
            echo "1. Review the PR at the link above"
            echo "2. Request review from your team"
            echo "3. Merge after approval"
            echo "4. **Manually run your dbt jobs after merge**"
          } >> "$GITHUB_STEP_SUMMARY"

      - name: No changes summary
        if: steps.cherry_pick.outputs.has_changes == 'false'
        shell: bash
        run: |
          {
            echo "## ℹ️ No Changes to Deploy"
            echo ""
            echo "No differences found between branches or all files were excluded."
          } >> "$GITHUB_STEP_SUMMARY"
``
